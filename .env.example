# Copy to .env and adjust. docker-compose.yml reads these.
POSTGRES_USER=hoopsai
POSTGRES_PASSWORD=hoopsai
POSTGRES_DB=hoopsai
# Host port for the compose Postgres (5433 so it can coexist with a native Postgres on 5432)
POSTGRES_HOST_PORT=5433

# Backend (pydantic-settings, prefix HOOPSAI_). Hostnames are compose service names.
HOOPSAI_ENV=dev
HOOPSAI_DATABASE_URL=postgresql+psycopg://hoopsai:hoopsai@db:5432/hoopsai
HOOPSAI_REDIS_URL=redis://redis:6379/0
HOOPSAI_MLFLOW_TRACKING_URI=http://mlflow:5000
HOOPSAI_CORS_ORIGINS=["http://localhost:3000"]
HOOPSAI_LOG_FORMAT=json
# Weekly in-game retrain needs ~750 MB of RAM in the worker container.
HOOPSAI_INGAME_RETRAIN=true

# Production (deploy/docker-compose.prod.yml): public HTTPS name, e.g. hoopsai.duckdns.org
DOMAIN=
